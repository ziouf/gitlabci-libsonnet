// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Jsonnet",
	"build": {"dockerfile": "Dockerfile"},
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"Grafana.vscode-jsonnet"
			],
			"settings": {
				"jsonnet.languageServer.enableAutoUpdate": true
			}
		}
	},
	"features": {
		"ghcr.io/devcontainers-extra/features/pre-commit": {}
	},
	"initializeCommand": {
		"extractGitGlobals": "git config -l --global --include > .gitconfig.global",
		"extractGitLocals": "git config -l --local --include > .gitconfig.local"
	},
	"postCreateCommand": {
		// "downloadJsonnetLanguageServer": "mkdir -p $HOME/.vscode-server/data/User/globalStorage/grafana.vscode-jsonnet/bin/ && curl -o $HOME/.vscode-server/data/User/globalStorage/grafana.vscode-jsonnet/bin/jsonnet-language-server -sSL https://github.com/grafana/jsonnet-language-server/releases/download/v0.15.0/jsonnet-language-server_0.15.0_linux_amd64"
	},
	"postStartCommand": {},
	"postAttachCommand": {
		"gitConfig": "/bin/bash .devcontainer/post-attach.sh"
	}
}
